APP_NAME="Nodo Control"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
AGENT_STALE_SECONDS=75
METRICS_RETENTION_DAYS=7

# Cuota protectora solo para inserción de telemetría (no límite físico de toda SQLite)
NODO_TELEMETRY_MAX_ROWS=150000
NODO_TELEMETRY_MAX_MIB=256
NODO_ADMIN_RETENTION_DAYS=180

# Historial de medios extraíbles (retención y límite de registros)
NODO_MEDIA_RETENTION_DAYS=180
NODO_MEDIA_MAX_EVENTS=50000

# Historial de eventos críticos de Windows (independiente de CPU/RAM)
NODO_SYSTEM_EVENT_RETENTION_DAYS=180
NODO_SYSTEM_EVENT_MAX_EVENTS=50000

# Informes PDF: instalar WeasyPrint en Debian; se ejecuta en un worker dedicado.
# Fechas visibles del informe (no modifica SQLite ni los datos enviados a la IA).
REPORT_TIMEZONE=America/Argentina/Buenos_Aires
NODO_PDF_BINARY=weasyprint
# IA desactivada por defecto desde Configuración > Informes.
# Claves y URL sólo en Debian (nunca en la UI ni en el agente).
# Modos admitidos: groq, openai, compatible (HTTPS) o local (loopback).
REPORT_AI_PROVIDER=groq
REPORT_AI_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
OPENAI_API_KEY=
# Opcional: proveedor compatible con OpenAI; configurar URL HTTPS confiable en el servidor.
REPORT_AI_COMPATIBLE_URL=
REPORT_AI_COMPATIBLE_KEY=
# Alternativa LOCAL (sin servicio externo): usar REPORT_AI_PROVIDER=local.
# Requiere un modelo con compatibilidad Chat Completions y tool calling.
# La URL local solo permite loopback del propio servidor Debian: http://127.0.0.1:PUERTO/v1.
# No abrir esta API local a Internet; el panel nunca recibe esta dirección ni credenciales.
REPORT_AI_LOCAL_URL=http://127.0.0.1:11434/v1

# Asistente: independiente de las conclusiones automáticas de los PDF.
# Reutiliza REPORT_AI_PROVIDER, REPORT_AI_MODEL y la clave del proveedor configurado.
NODO_ASSISTANT_ENABLED=false

# =============================================================================
# OSG NODO CONTROL - PLANTILLA DE CONFIGURACIÓN DEL SERVIDOR LARAVEL
# =============================================================================
# .env.example es una plantilla pública: no guardes claves reales en ella.
# .env y secrets/laravel.env contienen la configuración privada de la instalación.
# No es la configuración de los agentes Windows.
#
# CON DOCKER (instalación habitual):
#   1. Ejecuta: bash scripts/docker/setup.sh
#   2. No copies esta plantilla sobre el .env de la raíz: lo genera el instalador
#      para Compose (dirección, puerto y nombre del proyecto).
#   3. Laravel usa secrets/laravel.env, generado a partir de esta plantilla.
#      El instalador adapta APP_ENV, APP_URL, DB_DATABASE, logs y APP_KEY.
#   4. Para proveedor/modelo/clave externos usa:
#        python3 scripts/docker/configure.py api
#      Para opciones avanzadas sin asistente, edita secrets/laravel.env.
#   5. Tras cambiar la configuración Laravel, recrea los servicios:
#        docker compose up -d --force-recreate --no-build --wait --wait-timeout 180
#   Modificar esta plantilla NO actualiza una instalación ya configurada.
#
# SIN DOCKER (Laravel instalado directamente en el servidor):
#   Copia esta plantilla a .env solo en una instalación nueva y completa sus
#   valores. Genera APP_KEY con php artisan key:generate una sola vez.
#   Tras editar .env: php artisan config:clear y reinicia los procesos persistentes
#   de PHP, colas y scheduler con el gestor de servicios de tu instalación.
#   Conserva siempre la APP_KEY existente durante las actualizaciones.
#
# Guía y ejemplos completos: docs/CONFIGURACION-ENTORNO.md

# =============================================================================
# 1. APLICACIÓN Y DIRECCIÓN DEL PANEL
# =============================================================================
APP_NAME="Nodo Control"
# local para desarrollo; production cuando publiques el servicio.
# APP_ENV no elige entre acceso desde este servidor o desde otras computadoras.
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Dirección del servidor tal como acceden sus usuarios; no la IP de un agente.
# Ejemplo Laravel nativo: http://127.0.0.1:8000
# Docker genera su valor inicial: http://127.0.0.1:8088
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# =============================================================================
# 2. REGISTROS
# =============================================================================
# stack escribe en storage/logs; Docker configura stderr para docker compose logs.
LOG_CHANNEL=stack
LOG_LEVEL=warning

# =============================================================================
# 3. BASE DE DATOS SQLITE
# =============================================================================
DB_CONNECTION=sqlite
# Sin DB_DATABASE se utiliza database/database.sqlite dentro del proyecto.
# Para otra ubicación, define una ruta absoluta. Ejemplo sin Docker:
# DB_DATABASE=/ruta/al/proyecto/database/database.sqlite
# Docker genera DB_DATABASE=/data/sqlite/database.sqlite; conserva ese valor.

# =============================================================================
# 4. SESIONES Y CACHÉ
# =============================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# false para HTTP; true si la entrada al panel utiliza HTTPS correctamente.
SESSION_SECURE_COOKIE=false
CACHE_STORE=file

# =============================================================================
# 5. COLAS
# =============================================================================
# Valor general. Los informes usan explícitamente la conexión database/cola reports.
# Sin Docker necesitas un worker dedicado; Docker ya incluye el servicio worker.
# Ejemplo nativo: php artisan queue:work database --queue=reports --tries=1 --timeout=180
QUEUE_CONNECTION=sync

# =============================================================================
# 6. MONITOREO Y RETENCIÓN
# =============================================================================
# Umbral base en segundos para considerar un agente desconectado.
# El cálculo efectivo también tiene en cuenta su intervalo de heartbeat.
AGENT_STALE_SECONDS=75
# Compatibilidad: la retención activa de CPU/RAM se cambia en Configuración del
# panel. El mantenimiento actual usa esa preferencia, no esta variable heredada.
METRICS_RETENTION_DAYS=7

# Cuota de inserción de telemetría; NO limita el tamaño total del archivo SQLite.
NODO_TELEMETRY_MAX_ROWS=150000
NODO_TELEMETRY_MAX_MIB=256
# Retención de registros administrativos, en días.
NODO_ADMIN_RETENTION_DAYS=180

# Medios extraíbles: días de retención y cantidad máxima de eventos.
NODO_MEDIA_RETENTION_DAYS=180
NODO_MEDIA_MAX_EVENTS=50000

# Eventos de Windows: retención independiente de las muestras CPU/RAM.
NODO_SYSTEM_EVENT_RETENTION_DAYS=180
NODO_SYSTEM_EVENT_MAX_EVENTS=50000

# =============================================================================
# 7. INFORMES PDF Y HORARIO VISIBLE
# =============================================================================
# Zona inicial de presentación del panel, informes y contexto de IA.
# La selección guardada desde Configuración del panel tiene prioridad.
# Los instantes originales se conservan en UTC.
REPORT_TIMEZONE=America/Argentina/Buenos_Aires
# WeasyPrint debe estar instalado donde se ejecuta el worker.
# Docker ya lo incluye. Sin Docker debe existir en el servidor.
NODO_PDF_BINARY=weasyprint
# Opcional: límite de equipos en el inventario consolidado.
# REPORT_FLEET_MAX_DEVICES=250

# =============================================================================
# 8. IA - PROVEEDOR Y MODELO COMPARTIDOS
# =============================================================================
# Los PDF y el asistente usan este mismo proveedor/modelo.
# Proveedores del adaptador Laravel: groq, openai, compatible o local.
# El asistente Docker configure.py api configura proveedores externos;
# no ofrece el modo local. Para Ollama consulta la sección 10 y la guía.
#
# Mantén un solo valor activo para cada variable: los ejemplos son alternativas.
# El nombre del modelo debe coincidir con el catálogo del proveedor elegido.
REPORT_AI_PROVIDER=groq
REPORT_AI_MODEL=openai/gpt-oss-20b

# =============================================================================
# 9. IA EXTERNA - CLAVES Y EJEMPLOS
# =============================================================================
# A. Groq: usa GROQ_API_KEY y el identificador del catálogo de Groq.
# REPORT_AI_PROVIDER=groq
# REPORT_AI_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# B. OpenAI: usa OPENAI_API_KEY y un modelo disponible para tu cuenta.
# REPORT_AI_PROVIDER=openai
# REPORT_AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# C. Proveedor compatible: endpoint HTTPS de confianza, terminado normalmente en /v1.
# REPORT_AI_PROVIDER=compatible
# REPORT_AI_MODEL=identificador-del-modelo
# REPORT_AI_COMPATIBLE_URL=https://api.proveedor.example/v1
REPORT_AI_COMPATIBLE_URL=
REPORT_AI_COMPATIBLE_KEY=

# =============================================================================
# 10. IA LOCAL - EJEMPLO CON OLLAMA
# =============================================================================
# Ejemplo para Laravel SIN Docker y Ollama en el MISMO servidor:
#   ollama pull qwen3:8b
#   ollama list
# Usa el nombre exacto mostrado por ollama list. Ejemplo de configuración:
# REPORT_AI_PROVIDER=local
# REPORT_AI_MODEL=qwen3:8b
REPORT_AI_LOCAL_URL=http://127.0.0.1:11434/v1
# El modo local no necesita clave API en esta aplicación.
# El asistente necesita un modelo con tool calling; los informes, salida JSON.
# Descarga y ejecuta un modelo compatible con los recursos de tu servidor.
#
# ATENCIÓN CON DOCKER:
#   127.0.0.1 dentro de un contenedor apunta a ESE contenedor, no al anfitrión.
#   El Compose actual no incluye Ollama ni conecta el modo local al anfitrión.
#   La validación actual solo permite loopback en REPORT_AI_LOCAL_URL:
#   no admite host.docker.internal ni un nombre de servicio como ollama.
#   Cambiar solo esta URL no habilita Ollama en la distribución Docker actual.
#   Consulta docs/CONFIGURACION-ENTORNO.md antes de configurar inferencia local.

# =============================================================================
# 11. ACTIVACIÓN DE LAS FUNCIONES DE IA
# =============================================================================
# Asistente conversacional: habilitación del servidor, independiente de los PDF.
# true requiere un proveedor/modelo y, para proveedores externos, una clave válida.
NODO_ASSISTANT_ENABLED=false
# Conclusiones IA de los PDF: se activan por separado en el panel:
# Configuración > Informes PDF > Conclusión y recomendaciones mediante IA.
# Esa preferencia se guarda en SQLite; no tiene una variable de activación aquí.
